# Puerto HTTP local
PORT=3000

# Cambia este valor antes de publicar la aplicación.
TOKEN_SECRET=replace-with-a-long-random-secret

# Ruta opcional para la persistencia JSON usada por la demostración local.
# DATA_FILE=.data/transporte.json

# Parámetros reservados para desplegar el esquema de database/ en MySQL 8.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=transporte_conexion
MYSQL_USER=transporte_app
MYSQL_PASSWORD=replace-me
